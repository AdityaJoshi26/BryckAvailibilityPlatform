# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bryck_db
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────
# Uses the compose service name "db" as the host.
DATABASE_URL=postgresql://postgres:postgres@db:5432/bryck_db
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=8080
